# *.pbix

# Microsoft Office temporary files
~$*.xlsx
~$*.docx
~$*.pptx

# Python artifacts (for ETL / REST API scripts)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.env

# OS-generated files
.DS_Store
Thumbs.db
