# Power BI temporary and cache files
*.tmp
*.temp
~*
*.~*
AutoRecovery/
*.abf

# Power BI Desktop local settings & cache
.pbi/localSettings.json
.pbi/editorSettings.json

# Power BI Desktop large binaries (prefer .pbip for version control)
